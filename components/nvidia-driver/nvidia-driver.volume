# NVIDIA userspace for the moonshine and Steam containers, mounted at
# /usr/nvidia. Backed directly by the driver image (Driver=image).
#
# Forma builds, signs and loads the image, and counts it as one this
# component runs.
#
# The volume pins the image it was created from. After forma loads a new
# driver image, it is used only after `podman volume rm nvidia-driver-vol`
# as the account; podman auto-update restarts containers, not volumes.
[Volume]
VolumeName=nvidia-driver-vol
Driver=image
Image=localhost/moonshine/nvidia-driver:latest

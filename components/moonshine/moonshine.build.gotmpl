# The moonshine image, built by the account: podman build, rootless.
# The Containerfile is a data file, so materia installs it in the component's
# data directory; m_dataDir gives that directory for the account materia
# that renders this file.
[Build]
ImageTag=localhost/moonshine/moonshine:patches
File={{ m_dataDir "moonshine" }}/build/moonshine.Dockerfile
SetWorkingDirectory={{ m_dataDir "moonshine" }}/build
BuildArg=MOONSHINE_REPO=https://github.com/skewballfox/moonshine.git
BuildArg=MOONSHINE_REF=patches
# The commit to build; the build fails if the branch has moved since
BuildArg=MOONSHINE_COMMIT={{ .moonshine_commit }}
# The base image is pinned by digest in the Containerfile
Pull=missing

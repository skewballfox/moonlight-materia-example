# Steam, the app moonshine runs. No Quadlet names this image: the launcher
# (/etc/moonshine/launch-steam) runs it with podman run, so the component
# manifest lists steam-build.service to have materia start this build.
[Unit]
# Copies moonshine's Vulkan WSI layer out of the moonshine image
Requires=moonshine-build.service
After=moonshine-build.service

[Build]
ImageTag=localhost/moonshine/steam:latest
File={{ m_dataDir "moonshine" }}/build/steam.Dockerfile
SetWorkingDirectory={{ m_dataDir "moonshine" }}/build
Pull=missing
